# Copy to .env. Secrets never go in code or git.

# --- Dependency source (used by .\run.ps1 setup / deck-setup) --------------------------------------
# Your organisation's Artifactory. Leave blank to use public PyPI / npm.
# Typical PyPI format: https://<host>/artifactory/api/pypi/<repo-name>/simple
# If the repo needs login: https://<user>:<token>@<host>/artifactory/api/pypi/<repo-name>/simple
ARTIFACTORY_PYPI_URL=
# Only needed to rebuild the slides. Typical format: https://<host>/artifactory/api/npm/<repo-name>/
ARTIFACTORY_NPM_URL=
# Corporate root CA (.pem) if pip reports SSL certificate errors against Artifactory
ARTIFACTORY_CA_BUNDLE=
# Python used to create .venv if "python" is not on PATH, e.g. C:/Python312/python.exe
PYTHON_EXE=
# ---------------------------------------------------------------------------------------------------
MERIDIAN_LLM_PROVIDER=company         # company | openai | claude | fake (offline deterministic agent)

# Company LLM gateway (LLM@CIB Developer Assistant, OpenAI-compatible)
MERIDIAN_COMPANY_API_KEY=your-personal-key
MERIDIAN_COMPANY_BASE_URL=https://api.llm.cib.echonet/v1/openai
MERIDIAN_COMPANY_MODEL=gpt-oss-120b-ITG     # or mistral-small-2506-ITG, qwen3.6-35b-a3b, ...
MERIDIAN_COMPANY_CONTEXT_TOKENS=131000      # the chosen model's REAL context size
# MERIDIAN_COMPANY_CA_BUNDLE=C:/path/to/corporate-root-ca.pem

# OpenAI (or any OpenAI-compatible endpoint, e.g. a company-hosted model)
OPENAI_API_KEY=sk-...
MERIDIAN_OPENAI_MODEL=gpt-4.1
# MERIDIAN_OPENAI_BASE_URL=https://your-company-llm.example.com/v1

# Claude
ANTHROPIC_API_KEY=sk-ant-...
MERIDIAN_MODEL=claude-opus-5
MERIDIAN_EFFORT=medium

MERIDIAN_WORKERS=4
MERIDIAN_CREDIT_AUTO_CAP=50
# MERIDIAN_DATABASE_URL=postgresql+psycopg://user:pass@host/meridian
