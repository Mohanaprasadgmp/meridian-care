# Dependency source for "run.ps1 setup": your Artifactory PyPI URL (blank = public PyPI)
# e.g. https://<host>/artifactory/api/pypi/<repo-name>/simple
# with login: https://<user>:<token>@<host>/artifactory/api/pypi/<repo-name>/simple
ARTIFACTORY_PYPI_URL=
ARTIFACTORY_NPM_URL=
ARTIFACTORY_CA_BUNDLE=
PYTHON_EXE=

MERIDIAN_LLM_PROVIDER=company

# Company LLM (LLM@CIB Developer Assistant, OpenAI-compatible). Paste your personal key after the = sign.
MERIDIAN_COMPANY_API_KEY=
MERIDIAN_COMPANY_BASE_URL=https://api.llm.cib.echonet/v1/openai
MERIDIAN_COMPANY_MODEL=gpt-oss-120b-ITG
MERIDIAN_COMPANY_CONTEXT_TOKENS=131000
# If you get SSL/certificate errors, set the path to your corporate root CA .pem:
# MERIDIAN_COMPANY_CA_BUNDLE=C:/path/to/corporate-root-ca.pem
